# from https://develop.battle.net -> API Access -> Create Client
BLIZZ_CLIENT_ID=your_client_id_here
BLIZZ_CLIENT_SECRET=your_client_secret_here
BLIZZ_REGION=eu

# https://dashboard.stripe.com/test/apikeys (test mode while developing)
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID=price_your_monthly_price_id_here
STRIPE_PRODUCT_ID=prod_your_product_id_here

# Any long random string -- signs session cookies + password-reset/verification
# tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET=change_me_to_a_random_string
# Set to false for local dev (plain http://) -- leave unset/true in production
# (Railway serves https), or the login cookie won't be sent back at all.
COOKIE_SECURE=false

# postgresql+asyncpg://user:pass@host/db in production;
# see README for the local-dev docker run command
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5432/wowproject

# Leave unset/false for local dev -- set to true only on the hosted deploy
# (Railway), where it replaces the human's local run_cycle.py + Task
# Scheduler with an hourly in-process collection loop (collect_all.py).
ENABLE_BACKGROUND_COLLECTION=false

# --- Transactional email (verification + password reset), 2026-08-06 -------
# https://resend.com -> API Keys. Free tier: 3,000/month, 100/day, 1 domain.
# LEAVE THIS UNSET for local dev: mailer.py then writes the verification and
# reset links straight to the server log instead of sending anything, which is
# how you complete a signup locally without an inbox.
# The domain's DKIM/SPF/DMARC records go in **Railway**, at
# railway.com/workspace/domains/realm-arbitrage.com -- the domain was bought
# through Railway, so Railway manages the zone (its editor does MX too, with a
# priority field). WHOIS says Name.com only because that's Railway's backend
# registrar; there is no name.com account for it. Until the domain verifies,
# Resend only sends from onboarding@resend.dev and only to your own Resend
# account address.
RESEND_API_KEY=
# Must be on a Resend-verified domain.
MAIL_FROM=Realm Arbitrage <noreply@realm-arbitrage.com>

# --- Google OAuth login (2026-08-06) --------------------------------------
# https://console.cloud.google.com -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application.
# Authorized redirect URIs must include, byte for byte:
#   https://realm-arbitrage.com/auth/google/callback   (production)
#   http://127.0.0.1:8000/auth/google/callback         (local dev)
# ALSO REQUIRED: enable the **People API** on the project. httpx-oauth's Google
# client resolves the user's address via people.googleapis.com/v1/people/me,
# not the OIDC userinfo endpoint, so without it login fails at the final step
# with SERVICE_DISABLED. Leave the default scopes alone for the same reason.
# Both unset (the default) simply means the /auth/google/* routes aren't
# mounted and login.html hides the button -- everything else works.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Absolute public origin, no trailing slash -- used for the links inside emails
# and for Google's redirect_uri. Falls back to the request's own base URL when
# unset, which is fine locally but NOT in production: uvicorn isn't configured
# to trust Railway's proxy headers, so the scheme it infers can be http, and
# Google rejects a redirect_uri that doesn't match exactly.
# Production: https://realm-arbitrage.com
PUBLIC_BASE_URL=http://127.0.0.1:8000
